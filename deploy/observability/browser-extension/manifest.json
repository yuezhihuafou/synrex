{
  "manifest_version": 3,
  "name": "Synrex Transport Metadata Observer",
  "version": "1.1.0",
  "description": "Opt-in, bounded metadata-only ChatGPT connection timeline. Does not read prompts, replies, headers or payloads.",
  "permissions": ["webRequest", "storage", "tabs", "alarms"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["content.js"], "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html" }
}
