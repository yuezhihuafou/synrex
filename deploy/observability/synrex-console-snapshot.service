[Unit]
Description=Synrex out-of-process console snapshot

[Service]
Type=oneshot
Environment=SYNREX_STATE_DIR=%h/.local/share/devspace-cutover-20261018
Environment=SYNREX_RELEASE_ROOT=%h/services/devspace/releases
ExecStart=%h/.nvm/versions/node/v22.22.2/bin/node %h/.local/share/synrex-observability/active-console-snapshot.mjs
Nice=15
IOSchedulingClass=idle
MemoryMax=256M
CPUQuota=25%
TimeoutStartSec=20
UMask=0077
NoNewPrivileges=true
