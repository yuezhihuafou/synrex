[Unit]
Description=DevSpace LAN SSH relay from swy1 to gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -L 127.0.0.1:7678:127.0.0.1:7676 swy@192.168.5.9
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
